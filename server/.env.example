PORT=8000
NODE_ENV=development
TRUST_PROXY=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=trainee
DB_USER=postgres
DB_PASS=change_me

JWT_SECRET=change_me
JWT_RESET_SECRET=change_me_reset
CHECKIN_CODE_SECRET=change_me_checkin

# Sign in with Google / Apple. Without these the matching provider is refused
# (fail closed) rather than accepting a token minted for someone else's app.
# GOOGLE_OAUTH_AUDIENCES: comma-separated OAuth client IDs to accept as the token
# audience. Include the WEB client id -- the Android SDK mints tokens against it,
# not against the Android client id -- plus the iOS client id.
GOOGLE_OAUTH_AUDIENCES=xxx-web.apps.googleusercontent.com,xxx-ios.apps.googleusercontent.com
# The iOS bundle identifier; native Sign in with Apple uses it as the audience.
APPLE_BUNDLE_ID=com.juroctech.frontend

SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password

BILLING_MODE=revenuecat_only

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_PRICE_ID=price_...
STRIPE_PRICE_ID=price_...

# Subscription plans (1 / 3 / 6 / 12 months).
# Either set these explicit price ids, OR leave them blank and instead set a
# Stripe Price `lookup_key` of trainer_1m / trainer_3m / trainer_6m / trainer_12m
# on each price (the backend resolves by lookup_key when these are empty).
STRIPE_PRICE_ID_1M=price_...
STRIPE_PRICE_ID_3M=price_...
STRIPE_PRICE_ID_6M=price_...
STRIPE_PRICE_ID_12M=price_...
STRIPE_SUCCESS_URL=http://localhost:8081/checkout?success=true&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8081/checkout?canceled=true
STRIPE_PORTAL_RETURN_URL=http://localhost:8081/checkout?success=true

REVENUECAT_SECRET_API_KEY=rc_secret_...
REVENUECAT_WEBHOOK_AUTH=change_me_webhook_auth
# Must match the entitlement identifier in the RevenueCat dashboard AND the
# frontend's EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID (eas.json) exactly.
REVENUECAT_ENTITLEMENT_ID=Trainee Pro
REVENUECAT_API_URL=https://api.revenuecat.com/v1

# Founding-trainer promo: trainer profiles created up to and including the
# deadline get a free promotional entitlement (no purchase, no auto-charge).
# Clear FOUNDING_GRANT_DEADLINE to switch the promo off.
FOUNDING_GRANT_MONTHS=3
FOUNDING_GRANT_DEADLINE=2026-09-30

# Object storage (Cloudflare R2 — S3-compatible). These are R2 API token creds.
AWS_ACCESS_KEY_ID=r2_access_key_id
AWS_SECRET_ACCESS_KEY=r2_secret_access_key
AWS_S3_BUCKET=trainee-assets
# R2 S3 API endpoint for your account:
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Public base URL for serving objects (r2.dev dev URL or a custom domain):
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

GOOGLE_PLACES_API_KEY=AIza...

# Strict unknown-field policy: monitor | enforce
INPUT_UNKNOWN_FIELDS_MODE=monitor

# Rate limiting overrides
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_EMAIL_WINDOW_MS=900000
RATE_LIMIT_EMAIL_MAX=15
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=30
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=600
# ─── Public trainer pages (/t/<slug>) ────────────────────────
# Absolute base URL of the public site, no trailing slash. Used for the canonical
# link and the Open Graph tags. Leave it empty until a consumer domain exists —
# the page still renders, it just omits canonical/og:url rather than emitting a
# relative one that would point crawlers at the wrong host.
PUBLIC_WEB_URL=
# Optional overrides for the store links in the page footer. Both default to the
# published listings (see docs/force-update.md), so they are always present.
# Both stores are always rendered: the page is cached, so the platform cannot be
# detected server-side without Vary: User-Agent.
PUBLIC_APPLE_STORE_URL=
PUBLIC_PLAY_STORE_URL=
