# Copy this to .env.test (gitignored) and fill in real values for your machine.
#
# This is the ONE file that matters for test safety: without it, tests/setup.ts
# falls through to loading .env instead - the exact same database `npm run dev`
# points at - and every suite that opts into a database
# (see tests/withDatabase.ts) runs sequelize.sync({ force: true }), which drops
# and recreates every table.
#
# You are still protected even without this file: every database-backed suite
# runs inside its own dedicated Postgres schema (see db.ts and
# DB_TEST_SCHEMA), never inside `public`, so a running app connected to the
# same DB_NAME is never touched. But DB_NAME below should still point at a
# database you're comfortable a test run can freely create schemas in and drop
# tables inside - a "trainee_test" sibling of your real "trainee" dev database
# is the simplest setup, and needs no more than:
#
#   docker exec <your-postgres-container> createdb -U <user> trainee_test

NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trainee_test
DB_USER=admin
DB_PASS=admin

# Any value works - tests never call a real JWT/Stripe endpoint with these,
# they just need to be internally consistent within a test run.
JWT_SECRET=test-only-jwt-secret-not-for-production-use
CHECKIN_CODE_SECRET=test-only-checkin-secret-not-for-production-use
ASSIGN_CODE_SECRET=test-only-assign-code-secret-not-for-production-use
STRIPE_SECRET_KEY=sk_test_dummy_key_for_local_tests_only

# Every request in a suite comes from the same IP; without raising this the
# auth rate limiter starts asserting 429s instead of the behaviour under test.
# tests/setup.ts already defaults this, so it's optional here.
RATE_LIMIT_AUTH_MAX=100000
