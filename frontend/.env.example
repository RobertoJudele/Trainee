# Preferred single API URL override (works in all environments)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional environment-specific API URLs
EXPO_PUBLIC_API_URL_DEV=http://localhost:8000
EXPO_PUBLIC_API_URL_PROD=https://your-production-api.com

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_...
# Must match the RevenueCat entitlement *identifier* exactly (case + spaces).
# Store builds read this from eas.json, not from .env — keep both in sync.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="Trainee Pro"
EXPO_PUBLIC_REVENUECAT_PRODUCT_ID=com.trainee.trainer_monthly
EXPO_PUBLIC_ENABLE_STRIPE_CHECKOUT=0
EXPO_PUBLIC_REVENUECAT_DEBUG=0